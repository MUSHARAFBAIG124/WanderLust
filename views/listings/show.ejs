<% layout('/layout/boilerplate') %>
<div class="row">
    <div class="col-6 offset-2 mt-3">
        <h3><%= listing.title %></h3>
    </div>

    <div class="card col-6 offset-2 listing-card">
        <img src="<%= listing.image.url %>" class="card-img-top show-img" alt="listing_image">
        <div class="card-body">
            <div class="card-text">
                <p><%= listing.category %></p>
                <p>Own By <i><b><%= listing.owner.username %></b></i></p>

                <p><%= listing.description %></p>

                <p>&#8377; <%= listing.price.toLocaleString("en-IN") %></p>
                <p><%= listing.location %></p>
                <p><%= listing.country %></p>
            </div>
        </div>
    </div>
    <br>

    <% if (currUser && listing.owner._id.equals(currUser._id)) { %>
        <div class="btns col-6 offset-2" style="justify-content: flex-start;">
            <form method="get" action="/listings/<%= listing._id %>/edit">
                <button class="btn btn-dark">Edit</button>
            </form>
                <a href="/listings/<%= listing._id %>/bookings" class="btn btn-dark">View bookings</a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                <button class="btn btn-dark">Delete</button>
            </form>
        </div>
    <% } %>

   <!-- MAP -->
<% if (listing.latitude && listing.longitude) { %>
  <div class="col-6 offset-2 mt-3 mb-3">
    <h4>Where you'll be</h4>
    <div id="map"
         data-lat="<%= listing.latitude %>"
         data-lng="<%= listing.longitude %>"
         data-title="<%= listing.title %>"></div>
    <p class="text-muted mt-2">Approximate location. The exact address is shared after booking.</p>
  </div>

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css">
  <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
  <style>
    #map { height: 350px; width: 100%; border-radius: 12px; }
  </style>
  <script>
    const el = document.getElementById("map");
    const lat = parseFloat(el.dataset.lat);
    const lng = parseFloat(el.dataset.lng);

    const map = L.map("map").setView([lat, lng], 12);

    L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution: "&copy; OpenStreetMap contributors",
    }).addTo(map);

    const popup = document.createElement("b");
    popup.textContent = el.dataset.title;
    L.marker([lat, lng]).addTo(map).bindPopup(popup);


    // Recalculate the map size once the page layout has settled
    window.addEventListener("load", () => map.invalidateSize());
  </script>
<% } %>


    <!-- BOOKING FORM -->
    <div class="col-6 offset-2 mb-3 mt-3">
        <% if (currUser && !listing.owner._id.equals(currUser._id)) { %>
            <h4>Reserve this place</h4>
            <form action="/listings/<%= listing._id %>/bookings" method="POST">
                <div class="mb-3">
                    <label for="checkIn" class="form-label">Check-in</label>
                    <input type="date" name="booking[checkIn]" id="checkIn" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label for="checkOut" class="form-label">Check-out</label>
                    <input type="date" name="booking[checkOut]" id="checkOut" class="form-control" required>
                </div>
                <div class="mb-3">
                    <label for="guests" class="form-label">Guests</label>
                    <input type="number" name="booking[guests]" id="guests" min="1" value="1" class="form-control" required>
                </div>
                <button class="btn btn-dark">Reserve</button>
            </form>

            <script>
                const today = new Date().toISOString().split("T")[0];
                document.getElementById("checkIn").min = today;
                document.getElementById("checkOut").min = today;
            </script>
        <% } else if (!currUser) { %>
            <p><a href="/login">Log in</a> to reserve this place.</p>
        <% } %>
    </div>

    <hr class="col-6 offset-2">

    <div class="col-6 offset-2 mb-3 mt-3">
        <% if (currUser) { %>
            <h4>Leave a Review</h4>
            <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
                <div class="mb-3 mt-3">
                    <label for="rating" class="form-label">Rating</label>
                    <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
                </div>
                <div class="mb-3 mt-3">
                    <label for="comment" class="form-label">Comments</label>
                    <textarea name="review[comment]" id="comment" cols="30" rows="5" class="form-control" required></textarea>
                </div>
                <button class="btn btn-outline-dark">Submit</button>
            </form>
        <% } %>
        <hr>
        <p><b>All Reviews</b></p>

        <div class="row">
            <% for (let review of listing.reviews) { %>
                <div class="card col-5 ms-3 mb-3">
                    <div class="card-body">
                        <h5 class="card-title"><%= review.author.username %></h5>
                        <p class="card-text"><%= review.comment %></p>
                        <p class="card-text"><%= review.rating %> Stars</p>
                    </div>
                    <% if (currUser && review.author._id.equals(currUser._id)) { %>
                        <form class="mb-3" method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                            <button class="btn btn-sm btn-dark">Delete</button>
                        </form>
                    <% } %>
                </div>
            <% } %>
        </div>
    </div>
</div>